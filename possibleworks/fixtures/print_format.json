  "format_data": null,
  "html": "\n<style>\n  /* Defensive reset: Frappe's own print stylesheet applies !important border/padding\n     rules to every td/th inside .print-format. Every selector below is scoped under\n     .print-format .gvs-mr-box (3 classes) to out-specificity Frappe's 2-class rules,\n     and uses !important itself so nothing here can be silently overridden either. */\n  .print-format .gvs-mr-box, .print-format .gvs-mr-box * {\n    box-sizing: border-box !important;\n  }\n  .print-format .gvs-mr-box table {\n    border-collapse: collapse !important;\n    width: 100% !important;\n  }\n  .print-format .gvs-mr-box td, .print-format .gvs-mr-box th {\n    border: none !important;\n    padding: 0 !important;\n    vertical-align: top !important;\n    font-size: 11px !important;\n    color: #000 !important;\n    font-weight: normal !important;\n  }\n\n  .gvs-mr-letterhead-outer { display: flex; align-items: center; margin-bottom: 10px; }\n  .gvs-mr-logo-col { width: 70px; flex-shrink: 0; }\n  .gvs-mr-logo-col img { height: 70px; width: 70px; display: block; }\n  .gvs-mr-letterhead-text-outer { flex: 1; text-align: center; }\n  .gvs-mr-school-name { font-size: 20px; font-weight: bold; font-family: \"Times New Roman\", Times, serif; }\n  .gvs-mr-affiliation { font-size: 12px; font-family: \"Times New Roman\", Times, serif; }\n\n  .gvs-mr-box { border: 1px solid #000; font-family: \"Times New Roman\", Times, serif; font-size: 11px; color: #000; }\n  .gvs-mr-title { text-align: center; font-weight: bold !important; font-size: 14px !important; border-bottom: 1px solid #000 !important; padding: 4px 0 !important; letter-spacing: 1px; }\n  .print-format .gvs-mr-box .gvs-mr-header-table td { padding: 3px 8px !important; }\n  .gvs-mr-label { font-weight: normal; white-space: nowrap; }\n  .gvs-mr-value { font-weight: bold; }\n  .print-format .gvs-mr-box .gvs-mr-items th,\n  .print-format .gvs-mr-box .gvs-mr-items td {\n    border: 1px solid #000 !important;\n    padding: 4px 6px !important;\n  }\n  .gvs-mr-items th { font-weight: bold !important; text-align: center; }\n  .gvs-mr-spec { font-weight: bold; font-size: 10px !important; margin-top: 2px; }\n  .gvs-mr-total-row td { font-weight: bold !important; text-align: center; }\n  .print-format .gvs-mr-box .gvs-mr-filler-row td {\n    border-left: 1px solid #000 !important;\n    border-right: 1px solid #000 !important;\n    border-top: none !important;\n    border-bottom: none !important;\n    height: 420px !important;\n  }\n  .print-format .gvs-mr-box .gvs-mr-sign-table td {\n    padding-top: 4px !important;\n    border-top: none !important;\n    font-weight: bold !important;\n    text-align: center;\n  }\n  .print-format .gvs-mr-box .gvs-mr-sign-table .gvs-mr-sign-first-row td {\n    height: 90px !important;\n    vertical-align: bottom !important;\n  }\n  .gvs-mr-requester-name { padding: 0 8px !important; }\n  .gvs-mr-footer { text-align: center; font-size: 9px; border-top: 1px solid #000; margin-top: 12px; padding-top: 4px; }\n</style>\n\n{% set company_doc = frappe.get_cached_doc(\"Company\", doc.company) %}\n<div class=\"gvs-mr-letterhead-outer\">\n  <div class=\"gvs-mr-logo-col\">\n    {% if company_doc.company_logo %}\n    <img src=\"{{ frappe.utils.get_url(company_doc.company_logo) }}\" alt=\"{{ company_doc.company_name }}\" />\n    {% endif %}\n  </div>\n  <div class=\"gvs-mr-letterhead-text-outer\">\n    <div class=\"gvs-mr-school-name\">{{ company_doc.company_name }}</div>\n    {% if company_doc.custom_affiliation_no %}\n    <div class=\"gvs-mr-affiliation\">CBSE Affiliation No. {{ company_doc.custom_affiliation_no }}</div>\n    {% endif %}\n  </div>\n  <div class=\"gvs-mr-logo-col\"></div>\n</div>\n\n<div class=\"gvs-mr-box\">\n  <div class=\"gvs-mr-title\">MATERIAL REQUISITION</div>\n\n  <table class=\"gvs-mr-header-table\">\n    <tr>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-mr-label\">S.R.No :</span>\n        <span class=\"gvs-mr-value\">{{ doc.name }}</span>\n      </td>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-mr-label\">Indentor Name :</span>\n        <span class=\"gvs-mr-value\">{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-mr-label\">S.R.Date :</span>\n        <span class=\"gvs-mr-value\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd/mm/yyyy\") }}</span>\n      </td>\n      <td>\n        <span class=\"gvs-mr-label\">Required By Date :</span>\n        <span class=\"gvs-mr-value\">{{ frappe.utils.formatdate(doc.schedule_date, \"dd/mm/yyyy\") if doc.schedule_date else \"\" }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-mr-label\">Department :</span>\n        <span class=\"gvs-mr-value\">{{ doc.custom_department or \"\" }}</span>\n      </td>\n      <td>\n        <span class=\"gvs-mr-label\">Purpose :</span>\n        <span class=\"gvs-mr-value\">{{ doc.custom_purpose_note or \"\" }}</span>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"gvs-mr-items\">\n    <thead>\n      <tr>\n        <th>Sr</th>\n        <th>Item Code</th>\n        <th>Required By</th>\n        <th>Description</th>\n        <th>MIS</th>\n        <th>Quantity</th>\n        <th>Target Warehouse</th>\n        <th>UOM</th>\n        <th>Area of Application</th>\n        <th>Additional Details</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td style=\"text-align:center;\">{{ loop.index }}</td>\n        <td>{{ row.item_code }}</td>\n        <td>{{ frappe.utils.formatdate(row.schedule_date, \"dd-mm-yyyy\") if row.schedule_date else \"\" }}</td>\n        <td>{{ row.description or \"\" }}</td>\n        <td>{{ row.custom_mis or \"\" }}</td>\n        <td style=\"text-align:right;\">{{ row.uom }} {{ \"%.2f\" % row.qty }}</td>\n        <td>{{ row.warehouse or \"\" }}</td>\n        <td style=\"text-align:center;\">{{ row.uom or \"\" }}</td>\n        <td>{{ row.custom_area_of_application or \"\" }}</td>\n        <td>{{ row.custom_additional_details or \"\" }}</td>\n      </tr>\n      {% endfor %}\n      <tr class=\"gvs-mr-filler-row\">\n        <td colspan=\"10\"></td>\n      </tr>\n      <tr class=\"gvs-mr-total-row\">\n        <td colspan=\"5\">Total</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (doc.items | sum(attribute='qty')) }}</td>\n        <td colspan=\"4\"></td>\n      </tr>\n    </tbody>\n  </table>\n\n  <table class=\"gvs-mr-sign-table\">\n    <tr class=\"gvs-mr-sign-first-row\">\n      <td class=\"gvs-mr-requester-name\">\n        {{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }}\n      </td>\n      <td></td>\n      <td></td>\n    </tr>\n    <tr>\n      <td style=\"width:33%;\">Requested By</td>\n      <td style=\"width:33%;\">Stores</td>\n      <td style=\"width:34%;\">Head of the Department</td>\n    </tr>\n  </table>\n\n  <div class=\"gvs-mr-footer\">\n    {{ company_doc.custom_print_footer_address or \"\" }}\n  </div>\n</div>\n\n",
