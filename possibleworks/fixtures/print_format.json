  "html": "\n<style>\n  .print-format .gvs-po-box, .print-format .gvs-po-box * {\n    box-sizing: border-box !important;\n  }\n  .print-format .gvs-po-box table {\n    border-collapse: collapse !important;\n    width: 100% !important;\n  }\n  .print-format .gvs-po-box td, .print-format .gvs-po-box th {\n    border: none !important;\n    padding: 0 !important;\n    vertical-align: top !important;\n    font-size: 11px !important;\n    color: #000 !important;\n    font-weight: normal !important;\n  }\n\n  .gvs-po-letterhead-outer { display: flex; align-items: center; margin-bottom: 10px; }\n  .gvs-po-logo-col { width: 70px; flex-shrink: 0; }\n  .gvs-po-logo-col img { height: 70px; width: 70px; display: block; }\n  .gvs-po-letterhead-text-outer { flex: 1; text-align: center; }\n  .gvs-po-school-name { font-size: 20px; font-weight: bold; font-family: \"Times New Roman\", Times, serif; }\n  .gvs-po-affiliation { font-size: 12px; font-family: \"Times New Roman\", Times, serif; }\n\n  .gvs-po-box { border: 1px solid #000; font-family: \"Times New Roman\", Times, serif; font-size: 11px; color: #000; }\n  .gvs-po-title { text-align: center; font-weight: bold !important; font-size: 14px !important; border-bottom: 1px solid #000 !important; padding: 4px 0 !important; letter-spacing: 1px; }\n  .print-format .gvs-po-box .gvs-po-header-table td { padding: 3px 8px !important; }\n  .gvs-po-label { font-weight: normal; white-space: nowrap; }\n  .gvs-po-value { font-weight: bold; }\n  .print-format .gvs-po-box .gvs-po-items th,\n  .print-format .gvs-po-box .gvs-po-items td {\n    border: 1px solid #000 !important;\n    padding: 4px 6px !important;\n  }\n  .gvs-po-items th { font-weight: bold !important; text-align: center; }\n  .gvs-po-total-row td { font-weight: bold !important; text-align: center; }\n  .print-format .gvs-po-box .gvs-po-filler-row td {\n    border-left: 1px solid #000 !important;\n    border-right: 1px solid #000 !important;\n    border-top: none !important;\n    border-bottom: none !important;\n    height: 420px !important;\n  }\n  .print-format .gvs-po-box .gvs-po-sign-table td {\n    padding-top: 4px !important;\n    border-top: none !important;\n    font-weight: bold !important;\n    text-align: center;\n  }\n  .print-format .gvs-po-box .gvs-po-sign-table .gvs-po-sign-first-row td {\n    height: 90px !important;\n    vertical-align: bottom !important;\n  }\n  .gvs-po-requester-name { padding: 0 8px !important; }\n  .gvs-po-footer { text-align: center; font-size: 9px; border-top: 1px solid #000; margin-top: 12px; padding-top: 4px; }\n</style>\n\n{% set company_doc = frappe.get_cached_doc(\"Company\", doc.company) %}\n<div class=\"gvs-po-letterhead-outer\">\n  <div class=\"gvs-po-logo-col\">\n    {% if company_doc.company_logo %}\n    <img src=\"{{ frappe.utils.get_url(company_doc.company_logo) }}\" alt=\"{{ company_doc.company_name }}\" />\n    {% endif %}\n  </div>\n  <div class=\"gvs-po-letterhead-text-outer\">\n    <div class=\"gvs-po-school-name\">{{ company_doc.company_name }}</div>\n    {% if company_doc.custom_affiliation_no %}\n    <div class=\"gvs-po-affiliation\">CBSE Affiliation No. {{ company_doc.custom_affiliation_no }}</div>\n    {% endif %}\n  </div>\n  <div class=\"gvs-po-logo-col\"></div>\n</div>\n\n<div class=\"gvs-po-box\">\n  <div class=\"gvs-po-title\">PURCHASE ORDER</div>\n\n  <table class=\"gvs-po-header-table\">\n    <tr>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-po-label\">P.O.No :</span>\n        <span class=\"gvs-po-value\">{{ doc.name }}</span>\n      </td>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-po-label\">Supplier :</span>\n        <span class=\"gvs-po-value\">{{ doc.supplier_name or doc.supplier or \"\" }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-po-label\">P.O.Date :</span>\n        <span class=\"gvs-po-value\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd/mm/yyyy\") if doc.transaction_date else \"\" }}</span>\n      </td>\n      <td>\n        <span class=\"gvs-po-label\">Required By :</span>\n        <span class=\"gvs-po-value\">{{ frappe.utils.formatdate(doc.schedule_date, \"dd/mm/yyyy\") if doc.schedule_date else \"\" }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-po-label\">Company :</span>\n        <span class=\"gvs-po-value\">{{ doc.company or \"\" }}</span>\n      </td>\n      <td></td>\n    </tr>\n  </table>\n\n  <table class=\"gvs-po-items\">\n    <thead>\n      <tr>\n        <th>Sr</th>\n        <th>Item Code</th>\n        <th>Description</th>\n        <th>Required By</th>\n        <th>Qty</th>\n        <th>UOM</th>\n        <th>Rate</th>\n        <th>Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td style=\"text-align:center;\">{{ loop.index }}</td>\n        <td>{{ row.item_code }}</td>\n        <td>{{ row.description or \"\" }}</td>\n        <td>{{ frappe.utils.formatdate(row.schedule_date, \"dd-mm-yyyy\") if row.schedule_date else \"\" }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % row.qty }}</td>\n        <td style=\"text-align:center;\">{{ row.uom or \"\" }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (row.rate or 0) }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (row.amount or 0) }}</td>\n      </tr>\n      {% endfor %}\n      <tr class=\"gvs-po-filler-row\">\n        <td colspan=\"8\"></td>\n      </tr>\n      <tr class=\"gvs-po-total-row\">\n        <td colspan=\"4\">Total</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (doc.items | sum(attribute='qty')) }}</td>\n        <td></td>\n        <td></td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (doc.rounded_total or doc.grand_total or 0) }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <table class=\"gvs-po-sign-table\">\n    <tr class=\"gvs-po-sign-first-row\">\n      <td class=\"gvs-po-requester-name\">\n        {{ frappe.db.get_value(