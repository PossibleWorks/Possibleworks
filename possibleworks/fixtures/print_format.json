  "html": "\n<style>\n  .print-format .gvs-sq-box, .print-format .gvs-sq-box * {\n    box-sizing: border-box !important;\n  }\n  .print-format .gvs-sq-box table {\n    border-collapse: collapse !important;\n    width: 100% !important;\n  }\n  .print-format .gvs-sq-box td, .print-format .gvs-sq-box th {\n    border: none !important;\n    padding: 0 !important;\n    vertical-align: top !important;\n    font-size: 11px !important;\n    color: #000 !important;\n    font-weight: normal !important;\n  }\n\n  .gvs-sq-letterhead-outer { display: flex; align-items: center; margin-bottom: 10px; }\n  .gvs-sq-logo-col { width: 70px; flex-shrink: 0; }\n  .gvs-sq-logo-col img { height: 70px; width: 70px; display: block; }\n  .gvs-sq-letterhead-text-outer { flex: 1; text-align: center; }\n  .gvs-sq-school-name { font-size: 20px; font-weight: bold; font-family: \"Times New Roman\", Times, serif; }\n  .gvs-sq-affiliation { font-size: 12px; font-family: \"Times New Roman\", Times, serif; }\n\n  .gvs-sq-box { border: 1px solid #000; font-family: \"Times New Roman\", Times, serif; font-size: 11px; color: #000; }\n  .gvs-sq-title { text-align: center; font-weight: bold !important; font-size: 14px !important; border-bottom: 1px solid #000 !important; padding: 4px 0 !important; letter-spacing: 1px; }\n  .print-format .gvs-sq-box .gvs-sq-header-table td { padding: 3px 8px !important; }\n  .gvs-sq-label { font-weight: normal; white-space: nowrap; }\n  .gvs-sq-value { font-weight: bold; }\n  .print-format .gvs-sq-box .gvs-sq-items th,\n  .print-format .gvs-sq-box .gvs-sq-items td {\n    border: 1px solid #000 !important;\n    padding: 4px 6px !important;\n  }\n  .gvs-sq-items th { font-weight: bold !important; text-align: center; }\n  .gvs-sq-total-row td { font-weight: bold !important; text-align: center; }\n  .print-format .gvs-sq-box .gvs-sq-filler-row td {\n    border-left: 1px solid #000 !important;\n    border-right: 1px solid #000 !important;\n    border-top: none !important;\n    border-bottom: none !important;\n    height: 420px !important;\n  }\n  .print-format .gvs-sq-box .gvs-sq-sign-table td {\n    padding-top: 4px !important;\n    border-top: none !important;\n    font-weight: bold !important;\n    text-align: center;\n  }\n  .print-format .gvs-sq-box .gvs-sq-sign-table .gvs-sq-sign-first-row td {\n    height: 90px !important;\n    vertical-align: bottom !important;\n  }\n  .gvs-sq-requester-name { padding: 0 8px !important; }\n  .gvs-sq-footer { text-align: center; font-size: 9px; border-top: 1px solid #000; margin-top: 12px; padding-top: 4px; }\n</style>\n\n{% set company_doc = frappe.get_cached_doc(\"Company\", doc.company) %}\n<div class=\"gvs-sq-letterhead-outer\">\n  <div class=\"gvs-sq-logo-col\">\n    {% if company_doc.company_logo %}\n    <img src=\"{{ frappe.utils.get_url(company_doc.company_logo) }}\" alt=\"{{ company_doc.company_name }}\" />\n    {% endif %}\n  </div>\n  <div class=\"gvs-sq-letterhead-text-outer\">\n    <div class=\"gvs-sq-school-name\">{{ company_doc.company_name }}</div>\n    {% if company_doc.custom_affiliation_no %}\n    <div class=\"gvs-sq-affiliation\">CBSE Affiliation No. {{ company_doc.custom_affiliation_no }}</div>\n    {% endif %}\n  </div>\n  <div class=\"gvs-sq-logo-col\"></div>\n</div>\n\n<div class=\"gvs-sq-box\">\n  <div class=\"gvs-sq-title\">SUPPLIER QUOTATION</div>\n\n  <table class=\"gvs-sq-header-table\">\n    <tr>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-sq-label\">S.Q.No :</span>\n        <span class=\"gvs-sq-value\">{{ doc.name }}</span>\n      </td>\n      <td style=\"width:50%;\">\n        <span class=\"gvs-sq-label\">Supplier :</span>\n        <span class=\"gvs-sq-value\">{{ doc.supplier_name or doc.supplier or \"\" }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-sq-label\">S.Q.Date :</span>\n        <span class=\"gvs-sq-value\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd/mm/yyyy\") if doc.transaction_date else \"\" }}</span>\n      </td>\n      <td>\n        <span class=\"gvs-sq-label\">Valid Till :</span>\n        <span class=\"gvs-sq-value\">{{ frappe.utils.formatdate(doc.valid_till, \"dd/mm/yyyy\") if doc.valid_till else \"\" }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <span class=\"gvs-sq-label\">Company :</span>\n        <span class=\"gvs-sq-value\">{{ doc.company or \"\" }}</span>\n      </td>\n      <td></td>\n    </tr>\n  </table>\n\n  <table class=\"gvs-sq-items\">\n    <thead>\n      <tr>\n        <th>Sr</th>\n        <th>Item Code</th>\n        <th>Description</th>\n        <th>Qty</th>\n        <th>UOM</th>\n        <th>Rate</th>\n        <th>Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td style=\"text-align:center;\">{{ loop.index }}</td>\n        <td>{{ row.item_code }}</td>\n        <td>{{ row.description or \"\" }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % row.qty }}</td>\n        <td style=\"text-align:center;\">{{ row.uom or \"\" }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (row.rate or 0) }}</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (row.amount or 0) }}</td>\n      </tr>\n      {% endfor %}\n      <tr class=\"gvs-sq-filler-row\">\n        <td colspan=\"7\"></td>\n      </tr>\n      <tr class=\"gvs-sq-total-row\">\n        <td colspan=\"3\">Total</td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (doc.items | sum(attribute='qty')) }}</td>\n        <td></td>\n        <td></td>\n        <td style=\"text-align:right;\">{{ \"%.2f\" % (doc.rounded_total or doc.grand_total or 0) }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <table class=\"gvs-sq-sign-table\">\n    <tr class=\"gvs-sq-sign-first-row\">\n      <td class=\"gvs-sq-requester-name\">\n        {{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }}\n      </td>\n      <td></td>\n      <td></td>\n    </tr>\n    <tr>\n      <td style=\"width:33%;\">Prepared By</td>\n      <td style=\"width:33%;\">Verified By</td>\n      <td style=\"width:34%;\">Approved By</td>\n    </tr>\n  </table>\n\n  <div class=\"gvs-sq-footer\">\n    {{ company_doc.custom_print_footer_address or \"\" }}\n  </div>\n</div>\n",
